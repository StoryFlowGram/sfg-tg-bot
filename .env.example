WEB_APP_URL="https://example.com"
BOT_TOKEN="1234567890:AABCD_EFGHIJKLMN_OPQRSTUVWX"
BOT_MODE=polling
WEBHOOK_BASE_URL=https://example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=replace_with_random_secret
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
DROP_PENDING_UPDATES=true
BOT_MESSAGES_PER_MINUTE=20
BOT_RATE_LIMIT_WINDOW_SECONDS=60
BOT_START_COOLDOWN_SECONDS=10
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_REMINDER_QUEUE=sfg.word-reminders
IDENTITY_INTERNAL_URL=http://identity-service:8000/internal
LEARNING_INTERNAL_URL=http://learning-service:8000
INTERNAL_GATEWAY_TOKEN=replace_with_long_random_internal_token
